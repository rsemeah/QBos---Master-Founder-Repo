# .env.guard - Epistemological Guardrails for QBos
# 
# These settings enforce TruthSerum-first decision making.
# Use in scripts before opening UIs or claiming status.

# Prevent background dashboards from establishing authority
NO_LOCAL_DASHBOARDS=true
NO_BACKGROUND_AGENTS=true
NO_SERENA=true

# Single canonical source for "what is QBos?"
CANONICAL_STATUS=docs/QBOS_TODAY.md

# Receipt mode (immutable-first)
RECEIPT_MODE=append_only
RECEIPT_PATH=receipts/

# Tool authority rules
TOOL_BOUNDARIES=docs/TOOL_BOUNDARIES.md

# AI assistants are advisory only (never status reporters)
AI_ASSISTANTS_ADVISORY_ONLY=true
AI_ASSISTANTS_CANNOT_ASSERT_STATUS=true
CANONICAL_STATUS_FILE=docs/QBOS_TODAY.md

# Enforcement level (strict, lenient, off)
TRUTHSERUM_ENFORCEMENT=strict
