{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbos.dev/schemas/AppSpec.schema.json",
  "title": "QBos AppSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["appName", "archetype", "goals"],
  "properties": {
    "appName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "archetype": {
      "type": "string",
      "minLength": 1
    },
    "goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frontend": { "type": "string" },
        "backend": { "type": "string" },
        "database": { "type": "string" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
