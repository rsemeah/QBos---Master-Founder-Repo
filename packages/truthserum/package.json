{
  "name": "@qbos/truthserum",
  "version": "1.0.0",
  "type": "module",  "description": "TruthSerum - Proof-based state verification engine",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "verify": "node ../../scripts/smoke-truthserum.js"
  },
  "dependencies": {
    "@qbos/run": "workspace:*",
    "@supabase/supabase-js": "^2.89.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "typescript": "^5.3.0"
  }
}
