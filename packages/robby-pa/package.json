    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "@types/pg": "^8.6.6"
  },
  "dependencies": {
    "@qbos/run": "workspace:*",
    "express": "^4.18.2",
    "pg": "^8.11.0"
