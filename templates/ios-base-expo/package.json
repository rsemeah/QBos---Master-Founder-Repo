{
  "name": "@qbos/ios-base-expo",
  "version": "1.0.0",
  "private": true,
  "description": "Base Expo template for iOS apps built by QuietBuild OS",
  "main": "expo-router",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "submit:ios": "eas submit --platform ios",
    "update": "eas update"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "react": "18.3.1",
    "react-native": "0.74.0",
    "expo-status-bar": "~1.12.0",
    "@react-navigation/native": "^6.1.0",
    "expo-secure-store": "~13.0.0",
    "expo-constants": "~16.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.3.0",
    "typescript": "^5.3.0"
  }
}
